# =============================================================================
# 9Router Backend Configuration
# =============================================================================
# All settings loaded here. No hardcoded defaults in code.

# -- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

# -- Auth / JWT ---------------------------------------------------------------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -- App ----------------------------------------------------------------------
APP_NAME=9Router FastAPI
DEBUG=true

# -- Admin seed password (used on first login to auto-create admin) -----------
ADMIN_PASSWORD=123456

# -- CORS (comma-separated origins, or "*" for allow-all) ---------------------
CORS_ORIGINS=*

# -- Grok CLI research dumps (.scratch/grok-cli/). Off unless true ------------
GROK_CLI_DUMP=false
#GROK_CLI_DUMP_DIR=

# -- OAuth: Claude ------------------------------------------------------------
#CLAUDE_CLIENT_ID=your-claude-client-id

# -- OAuth: Codex (OpenAI) ----------------------------------------------------
#CODEX_CLIENT_ID=your-codex-client-id

# -- OAuth: Gemini (Google) ---------------------------------------------------
#GEMINI_CLIENT_ID=your-gemini-client-id
#GEMINI_CLIENT_SECRET=your-gemini-client-secret

# -- OAuth: Qwen --------------------------------------------------------------
#QWEN_CLIENT_ID=your-qwen-client-id

# -- OAuth: iFlow -------------------------------------------------------------
#IFLOW_CLIENT_ID=your-iflow-client-id
#IFLOW_CLIENT_SECRET=your-iflow-client-secret

# -- OAuth: Antigravity (Google Cloud Code) -----------------------------------
#ANTIGRAVITY_CLIENT_ID=your-antigravity-client-id
#ANTIGRAVITY_CLIENT_SECRET=your-antigravity-client-secret

# -- OAuth: GitHub (Copilot) --------------------------------------------------
#GITHUB_CLIENT_ID=your-github-client-id

# -- OAuth: Kimi Coding -------------------------------------------------------
#KIMI_CODING_CLIENT_ID=your-kimi-coding-client-id
