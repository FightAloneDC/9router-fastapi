# =============================================================================
# Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env.docker and fill in real values.
# .env.docker is gitignored — never commit it.

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=dev_9route
POSTGRES_PASSWORD=dev_9route_pass
POSTGRES_DB=db_9route

# -- Backend DATABASE_URL (async, used by FastAPI) ----------------------------
DATABASE_URL=postgresql+asyncpg://dev_9route:dev_9route_pass@db:5432/db_9route
